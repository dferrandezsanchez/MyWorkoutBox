COMPOSE_PROJECT_NAME=stelios
IMAGE_TAG=local
APP_PORT=8080

MARIADB_DATABASE=stelios
MARIADB_USER=stelios
MARIADB_PASSWORD=local-database-password
MARIADB_ROOT_PASSWORD=local-root-password
DATABASE_URL=mysql://stelios:local-database-password@database:3306/stelios

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8080
VITE_MARKETING_URL=
