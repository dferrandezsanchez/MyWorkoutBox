{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_MARKETING_URL=https://steliosapp.com",
        "VITE_API_URL=http://localhost:3001",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}